# Melhor Envio (modulo de Envios)
# Token pessoal gerado no painel: Integracoes > Permissoes de Acesso > Gerar novo token.
# Permissoes necessarias: shipping-calculate, shipping-companies, cart-read, cart-write,
# shipping-checkout, shipping-generate, shipping-preview, shipping-print, shipping-cancel,
# shipping-tracking, purchases-read, users-read. Validade de 1 ano.
MELHOR_ENVIO_TOKEN=""
# CEP de onde as encomendas sao postadas (so digitos)
MELHOR_ENVIO_CEP_ORIGEM=""
# "true" usa o ambiente de teste do Melhor Envio (saldo ficticio, nao gasta dinheiro)
MELHOR_ENVIO_SANDBOX="false"
MELHOR_ENVIO_TOKEN_SANDBOX=""
